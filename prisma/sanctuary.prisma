model Sanctuary {
  id             String                  @id @default(cuid())
  slug           String                  @unique
  code           String                  @unique
  name           String
  tagline        String
  city           String
  region         String
  country        String
  latitude       Float
  longitude      Float
  mapUrl         String?
  timezone       String                  @default("Europe/Rome")
  currency       String                  @default("EUR")
  status         String                  @default("ACTIVE")
  contactEmail   String
  contactPhone   String
  mediaData      Json
  editorial      Json
  arrivalGuide   Json
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  description    String?
  accommodations AccommodationCategory[]
  bookings       Booking[]
  diningVenues   DiningVenue[]
  experiences    Experience[]
  rateRules      RateRule[]
  roomUnits      RoomUnit[]
  staff          StaffMember[]
}

model DiningVenue {
  id            String    @id @default(cuid())
  sanctuaryId   String
  name          String
  cuisineType   String
  michelinStars Int?
  dressCode     String
  hours         String
  mediaData     Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sanctuary     Sanctuary @relation(fields: [sanctuaryId], references: [id], onDelete: Cascade)
}

model Experience {
  id               String            @id @default(cuid())
  sanctuaryId      String
  slug             String            @unique
  title            String
  category         String
  tagline          String
  durationMinutes  Int
  pricePerPerson   Float
  currency         String            @default("EUR")
  maxPartySize     Int
  mediaData        Json
  narrative        Json
  scheduleData     Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookingLineItems BookingLineItem[]
  sanctuary        Sanctuary         @relation(fields: [sanctuaryId], references: [id], onDelete: Cascade)
}

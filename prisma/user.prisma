model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  passwordHash        String?
  phoneNumber         String        @unique
  title               String?
  firstName           String
  lastName            String
  avatarUrl           String?
  role                UserRole      @default(GUEST)
  sovereignTier       SovereignTier @default(EXPLORER)
  sovereignKeyNumber  String        @unique
  lifetimeStaysCount  Int           @default(0)
  lifetimeSpendTotal  Float         @default(0.0)

  profile             GuestProfile?
  bookings            Booking[]
  sessions            UserSession[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model GuestProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  passportData        Json?
  preferences         Json?
  sensoryPreferences  Json     // Circadian, pillow, tea, aroma, baths

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OtpChallenge {
    id            String   @id @default(cuid())
    identifier    String   
    userId        String   
    tokenHash     String   // bcrypt/argon2 or sha256 hash of the 6-digit OTP
    attempts      Int      @default(0)
    expiresAt     DateTime
    createdAt     DateTime @default(now())
}

model UserSession {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    tokenHash String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())

    @@index([userId])
    @@index([expiresAt])
}
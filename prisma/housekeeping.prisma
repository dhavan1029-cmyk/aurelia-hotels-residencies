model HousekeepingTask {
  id              String    @id @default(cuid())
  sanctuaryId     String
  roomUnitId      String
  taskType        String
  priority        String    @default("STANDARD")
  status          String    @default("PENDING")
  assignedStaffId String?
  checklistData   Json
  notes           String?
  scheduledFor    DateTime
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  roomUnit        RoomUnit  @relation(fields: [roomUnitId], references: [id], onDelete: Cascade)
}

model StaffMember {
  id               String     @id @default(cuid())
  sanctuaryId      String
  name             String
  role             StaffRole
  email            String     @unique
  phone            String
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  avatarUrl        String?
  assignedBookings Booking[]  @relation("BookingAssignedMajordomo")
  assignedRooms    RoomUnit[]
  sanctuary        Sanctuary  @relation(fields: [sanctuaryId], references: [id], onDelete: Cascade)
  primaryForUser   User[]     @relation("UserPrimaryMajordomo")
}

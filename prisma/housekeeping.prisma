model HousekeepingTask {
  id            String             @id @default(cuid())
  sanctuaryId   String
  roomUnitId    String
  roomUnit      RoomUnit           @relation(fields: [roomUnitId], references: [id], onDelete: Cascade)
  taskType      String
  priority      String             @default("STANDARD")
  status        String             @default("PENDING")
  assignedStaffId String?
  checklistData Json
  notes         String?
  scheduledFor  DateTime
  completedAt   DateTime?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model StaffMember {
  id            String      @id @default(cuid())
  sanctuaryId   String
  sanctuary     Sanctuary   @relation(fields: [sanctuaryId], references: [id], onDelete: Cascade)
  name          String
  role          StaffRole
  email         String      @unique
  phone         String
  avatarUrl     String?
  isActive      Boolean     @default(true)
  assignedRooms RoomUnit[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}